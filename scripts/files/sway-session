#!/bin/sh
# Session entry used by the login screen. Sets Wayland-friendly environment and adds
# --unsupported-gpu only when the NVIDIA proprietary driver is loaded (sway refuses it otherwise).
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
export QT_QPA_PLATFORM="wayland;xcb" ELECTRON_OZONE_PLATFORM_HINT=auto
export MOZ_ENABLE_WAYLAND=1 _JAVA_AWT_WM_NONREPARENTING=1
# PATH and other variables your programs need (replaces `exec source ~/.zshrc` from the i3 setup)
[ -r "$HOME/.config/sway/env" ] && . "$HOME/.config/sway/env"

args=""
if [ -d /proc/driver/nvidia ]; then
  export LIBVA_DRIVER_NAME=nvidia __GLX_VENDOR_LIBRARY_NAME=nvidia WLR_NO_HARDWARE_CURSORS=1
  args="--unsupported-gpu"
fi
# shellcheck disable=SC2086
exec sway $args "$@"
