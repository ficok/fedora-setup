#!/usr/bin/env bash
# wallpaper <image>   set and remember a wallpaper (replaces `nitrogen --restore`)
# wallpaper restore   re-apply the remembered one (used at login)
conf="${XDG_CONFIG_HOME:-$HOME/.config}/wallpaper-path"
case "${1:-restore}" in
  restore) img="$(cat "$conf" 2>/dev/null || true)" ;;
  *)       img="$(realpath "$1")"; printf '%s\n' "$img" > "$conf" ;;
esac
if [ -f "${img:-}" ]; then swaymsg -q output '*' bg "$img" fill
else swaymsg -q output '*' bg '#11111b' solid_color; fi
