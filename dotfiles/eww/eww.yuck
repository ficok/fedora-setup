;; eww config: a top bar and a bottom bar (replaces polybar). Reload with $mod+Shift+B (eww reload).
;; Docs: https://elkowar.github.io/eww/

;; ---- data sources ----------------------------------------------------------------
;; deflisten: a long-running script; each line it prints becomes the new value.
;; defpoll:   a command re-run every :interval.
(deflisten workspaces :initial "[]" "$HOME/.config/eww/scripts/workspaces.sh")
(deflisten active_window :initial "" "$HOME/.config/eww/scripts/window-title.sh")
(defpoll time :interval "10s" "date '+%a %d %b   %H:%M'")
(defpoll cpu  :interval "3s"  "$HOME/.config/eww/scripts/cpu.sh")
(defpoll mem  :interval "5s"  "$HOME/.config/eww/scripts/mem.sh")
(defpoll disk :interval "60s" "df --output=pcent / | tail -1 | tr -d ' %'")
(defpoll vol  :interval "1s"  "$HOME/.config/eww/scripts/volume.sh get")

;; ---- widgets ---------------------------------------------------------------------
(defwidget workspaces-widget []
  (box :class "workspaces" :space-evenly false :spacing 4
    (for ws in workspaces
      (button :class {ws.active ? "ws active" : ws.occupied ? "ws occupied" : "ws"}
              :onclick "swaymsg workspace number ${ws.id}"
        "${ws.id}"))))

(defwidget title-widget []
  (label :class "title" :limit-width 60 :text active_window))

;; click: toggle calendar popup
(defwidget clock-widget []
  (eventbox :onclick "eww open --toggle calendar"
    (label :class "clock" :text time)))

;; click: mixer, right-click: mute, scroll: volume
(defwidget volume-widget []
  (eventbox :onclick "pavucontrol"
            :onrightclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
            :onscroll "$HOME/.config/eww/scripts/volume.sh {}"
    (label :class "vol" :text "VOL ${vol}")))

(defwidget stat [title val]
  (box :class "stat" :space-evenly false :spacing 6
    (label :class "stat-title" :text title)
    (label :text val)))

;; ---- windows ---------------------------------------------------------------------
(defwindow bar-top
  :monitor 0
  :stacking "fg"
  :exclusive true
  :geometry (geometry :x "0%" :y "6px" :width "98%" :height "34px" :anchor "top center")
  (centerbox :class "bar"
    (box :halign "start" :space-evenly false :spacing 14
      (workspaces-widget) (title-widget))
    (box :halign "center" (clock-widget))
    (box :halign "end" :space-evenly false :spacing 14
      (volume-widget)
      (systray :spacing 8 :icon-size 16 :class "tray"))))

(defwindow bar-bottom
  :monitor 0
  :stacking "fg"
  :exclusive true
  :geometry (geometry :x "0%" :y "6px" :width "98%" :height "30px" :anchor "bottom center")
  (centerbox :class "bar"
    (box :halign "start" :space-evenly false :spacing 18
      (stat :title "CPU"  :val "${cpu}%")
      (stat :title "RAM"  :val "${mem}%")
      (stat :title "DISK" :val "${disk}%"))
    (box)
    (box :halign "end" :space-evenly false :spacing 10
      (button :class "btn" :onclick "loginctl lock-session" "Lock")
      (button :class "btn" :onclick "swaymsg exit" "Exit"))))

(defwindow calendar
  :monitor 0
  :stacking "overlay"
  :geometry (geometry :x "0px" :y "48px" :width "270px" :anchor "top center")
  (box :class "popup" (calendar)))
