# This file contains core window manager settings. (Ported from your i3 config.)
# Following files contain further configuration:
#   autostart.conf, app_shortcuts.conf, scratchpad.conf, window_constraints.conf, keybindings.conf
#   wayland.conf (new: things that were X11 tools in i3, plus Wayland additions)

# Mod1 = Alt
set $mod Mod1

# Colors. i3 read these from X resources (set_from_resource); sway has no such directive.
# These are the Catppuccin Mocha values used in dotfiles/kitty/kitty.conf.
# Replace them with the values from your ~/.Xresources if you want your old palette.
set $foreground #cdd6f4
set $background #1e1e2e
set $cyan       #94e2d5
set $yellow     #f9e2af
set $gray       #a6adc8
set $green      #a6e3a1
set $red        #f38ba8

# Idle timers in seconds (used by swayidle in autostart.conf)
set $lock_timeout       300
set $screen_off_timeout 330

# NOTE: variables are defined above the includes on purpose: sway reads includes in place.
include ~/.config/sway/autostart.conf
include ~/.config/sway/app_shortcuts.conf
include ~/.config/sway/scratchpad.conf
include ~/.config/sway/window_constraints.conf
include ~/.config/sway/keybindings.conf
include ~/.config/sway/wayland.conf

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Exo 2 12

# Gaps
gaps inner 0
gaps outer 0
gaps top 0
gaps bottom 0
# gaps inner 8     # <- sway supports real gaps; try these two
# gaps outer 4

# Border style
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
# for_window [class=".*"] title_format "<span font='Input 2'> <\span> "
# for_window [all] title_window_icon yes
# for_window [all] title_window_icon padding 15
# title_align left


# class                 border  background text         indicator
client.focused_inactive $cyan   $cyan      $background  $green
client.focused          $yellow $yellow    $background  $green
client.unfocused        $gray   $gray      $background  $green
client.urgent           $red    $red       $background  $yellow
client.placeholder      #000000 #0c0c0c    #ffffff      #000000

# window style
#for_window [title="nmtui"] floating enable
#for_window [title="nmtui"] set size 500 500

# Distribution snippets (systemd/dbus environment import for portals, etc.)
include /etc/sway/config.d/*
